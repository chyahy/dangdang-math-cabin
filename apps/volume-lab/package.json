{
  "name": "dangdang-3d-volume-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:site": "tsc --noEmit && vite build --outDir ../../site/volume-lab --emptyOutDir",
    "build:offline": "tsc --noEmit && node scripts/build-offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:ui": "playwright test",
    "test:offline": "node e2e/offline.cjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "@react-three/fiber": "9.8.2",
    "@react-three/drei": "10.7.9",
    "framer-motion": "14.9.0",
    "lucide-react": "1.66.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "vitest": "^5.0.5",
    "@playwright/test": "^1.64.1"
  }
}
